{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "build": {
    "env": { "VITE_API_URL": "/api" }
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "Backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
